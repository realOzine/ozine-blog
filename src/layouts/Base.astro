---
import { Image } from 'astro:assets'
import Analytics from '@vercel/analytics/astro'
import '../styles/global.css'
// 两款中文字体都按 unicode-range 分片，浏览器只下载页面用到的那些字。
// 它们的 @font-face 列表有三百多 KB，所以不并进主样式表，而是作为单独的样式表放在 <body> 末尾，不挡住首屏渲染。
import wenkaiCss from 'lxgw-wenkai-screen-web/lxgwwenkaiscreen/result.css?url'
import serifCss from '@fontsource/noto-serif-sc/600.css?url'
import character from '../../pic/character.png'
import favicon from '../../pic/favicon.svg?url'
import { site } from '../site.config'

interface Props {
  title?: string
  description?: string
  /** 页面主体的最大宽度；文章详情页需要给目录留出位置 */
  wide?: boolean
}

const { title, description = site.description, wide = false } = Astro.props
const pageTitle = title ? `${title} · ${site.title}` : site.title
const width = wide ? 'max-w-5xl' : 'max-w-3xl'
// 看板娘只在右侧留白放得下时显示：视口宽度 ≥ 内容宽度 + 两侧各（看板娘 8rem + 右边距 1.5rem）再留一点余量。
// 媒体查询里的 rem 按 16px 算，而页面的 rem 是 17px（见 global.css），下面两个数已按此折算；改内容宽度或看板娘尺寸时要重算。
const mascotFrom = wide ? 'min-[88rem]:block' : 'min-[72rem]:block'
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col bg-page font-body text-body antialiased">
    <header class={`mx-auto w-full px-5 ${width}`}>
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-line py-6">
        <a href="/" class="group flex items-center gap-2.5 font-serif text-xl tracking-[0.32em] text-heading lowercase">
          <span
            class="twinkle text-base tracking-normal text-deco transition-[rotate] duration-700 ease-out motion-safe:group-hover:rotate-180"
            aria-hidden="true">✦</span
          >{site.title}
        </a>
        <a
          href={site.github}
          target="_blank"
          rel="me noopener"
          aria-label="GitHub 主页"
          class="text-muted transition duration-300 ease-out hover:text-heading motion-safe:hover:scale-110 motion-safe:hover:-rotate-6"
        >
          <svg viewBox="0 0 16 16" class="size-6" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
        </a>
      </div>
    </header>

    <main class={`mx-auto w-full flex-1 px-5 pt-4 pb-16 ${width}`}>
      <slot />
    </main>

    <footer class={`mx-auto w-full px-5 ${width}`}>
      <p class="border-t border-line py-8 text-center text-sm text-muted">
        <span class="twinkle mr-1.5 text-deco" aria-hidden="true">✦</span>{`© ${new Date().getFullYear()} ${site.title}`}
      </p>
    </footer>

    <Image
      src={character}
      alt=""
      width={136}
      densities={[1, 2]}
      class:list={[
        'figure mascot pointer-events-none fixed right-6 bottom-0 hidden w-32 select-none print:hidden',
        mascotFrom,
      ]}
    />

    <link rel="stylesheet" href={wenkaiCss} />
    <link rel="stylesheet" href={serifCss} />
  </body>
</html>
