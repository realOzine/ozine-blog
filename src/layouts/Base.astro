---
import Analytics from '@vercel/analytics/astro'
// 公式的排版样式；它的字体只在页面上真有公式时才会被下载。必须排在 global.css 前面：后者要盖掉它的字号和间距。
import 'katex/dist/katex.min.css'
import '../styles/global.css'
// 两款等宽字体都是可变字重、只含西文分片，样式表很小，直接并进主样式表。
import '@fontsource-variable/inconsolata'
import '@fontsource-variable/source-code-pro'
// 霞鹜文楷按 unicode-range 分片，浏览器只下载页面用到的那些字。常规和粗体两份 @font-face 列表各一百多 KB，
// 所以不并进主样式表，而是作为单独的样式表放在 <body> 末尾，不挡住首屏渲染。
import wenkaiCss from 'lxgw-wenkai-webfont/lxgwwenkai-regular.css?url'
import wenkaiBoldCss from 'lxgw-wenkai-webfont/lxgwwenkai-bold.css?url'
import favicon from '../../pic/favicon.png?url'
import { site } from '../site.config'

interface Props {
  title?: string
  description?: string
  /** 文章页在左上角显示返回首页的链接 */
  back?: boolean
  /** 分享卡片的类型：文章页传 article */
  type?: 'website' | 'article'
}

const { title, description = site.description, back = false, type = 'website' } = Astro.props
const pageTitle = title ? `${title} · ${site.title}` : site.title
// 正式地址：预览域名、带查询参数的访问都归到 ozine.me 的这个地址上
const canonical = new URL(Astro.url.pathname, Astro.site).href
const image = new URL(favicon, Astro.site).href
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- 分享卡片（X、Telegram、微信等的链接预览）：只有文字和头像，不做配图 -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content={`@${site.twitter.split('/').pop()}`} />
    <slot name="head" />
    <link rel="icon" type="image/png" href={favicon} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <!-- 在页面画出来之前套用上次选的主题，避免闪一下；没选过就跟随系统 -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme')
        if (theme) document.documentElement.dataset.theme = theme
      } catch {}
    </script>
    <Analytics />
  </head>
  <body>
    <header class="nav">
      {back && <a href="/">&lt; {site.name}</a>}
      <div>
        <!-- 文字是「要切到的那个主题」的名字，由下面的脚本填；脚本没运行时按钮不出现 -->
        <button id="theme" type="button" hidden></button>
        <a href="/projects/">projects</a>
        <a href={site.twitter} target="_blank" rel="me noopener">twitter</a>
        <a href={site.github} target="_blank" rel="me noopener">github</a>
        <a href="/rss.xml">rss</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <script is:inline>
      {
        const root = document.documentElement
        const button = document.getElementById('theme')
        const current = () =>
          root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        const label = () => (button.textContent = current() === 'dark' ? 'light' : 'dark')
        button.onclick = () => {
          root.dataset.theme = button.textContent
          try {
            localStorage.setItem('theme', root.dataset.theme)
          } catch {}
          label()
        }
        label()
        button.hidden = false
      }
    </script>

    <link rel="stylesheet" href={wenkaiCss} />
    <link rel="stylesheet" href={wenkaiBoldCss} />
  </body>
</html>
