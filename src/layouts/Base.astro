---
import Analytics from '@vercel/analytics/astro'
import '../styles/global.css'
import { site } from '../site.config'

interface Props {
  title?: string
  description?: string
  /** 页面主体的最大宽度；文章详情页需要给目录留出位置 */
  wide?: boolean
}

const { title, description = site.description, wide = false } = Astro.props
const pageTitle = title ? `${title} · ${site.title}` : site.title
const path = Astro.url.pathname
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href))
const width = wide ? 'max-w-5xl' : 'max-w-3xl'
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col bg-stone-50 font-sans text-stone-800 antialiased dark:bg-stone-950 dark:text-stone-200">
    <header class={`mx-auto flex w-full items-baseline justify-between px-5 py-8 ${width}`}>
      <a href="/" class="text-lg font-semibold tracking-tight">{site.title}</a>
      <nav class="flex gap-5 text-sm">
        {
          site.nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="text-stone-500 hover:text-accent aria-[current=page]:text-stone-900 dark:text-stone-400 dark:aria-[current=page]:text-stone-100"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class={`mx-auto w-full flex-1 px-5 pb-16 ${width}`}>
      <slot />
    </main>

    <footer class={`mx-auto w-full px-5 py-8 text-sm text-stone-500 ${width}`}>
      © {new Date().getFullYear()} {site.title}
    </footer>
  </body>
</html>
