---
import TagLinks from '../../components/TagLinks.astro'
import Base from '../../layouts/Base.astro'
import { getTags } from '../../lib/posts'

const tags = await getTags()
---

<Base title="标签">
  <h1 class="py-6 text-2xl font-semibold tracking-tight">标签</h1>
  {
    tags.length === 0 ? (
      <p class="text-stone-500">还没有标签。</p>
    ) : (
      <TagLinks tags={tags} />
    )
  }
</Base>
