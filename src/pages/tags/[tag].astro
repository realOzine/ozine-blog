---
import PostList from '../../components/PostList.astro'
import Base from '../../layouts/Base.astro'
import { getTags, type Tag } from '../../lib/posts'

export async function getStaticPaths() {
  const tags = await getTags()
  return tags.map((tag) => ({ params: { tag: tag.key }, props: { tag } }))
}

interface Props {
  tag: Tag
}

const { tag } = Astro.props
---

<Base title={`#${tag.label}`}>
  <div class="py-6">
    <h1 class="text-2xl font-semibold tracking-tight">#{tag.label}</h1>
    <p class="mt-2 text-sm text-stone-500">
      {tag.posts.length} 篇文章 · <a href="/tags/" class="hover:text-accent">全部标签</a>
    </p>
  </div>
  <PostList posts={tag.posts} />
</Base>
