---
import PostList from '../components/PostList.astro'
import Base from '../layouts/Base.astro'
import { getPosts } from '../lib/posts'
import { site } from '../site.config'

const posts = await getPosts()
const recent = posts.slice(0, site.recentCount)
---

<Base>
  <section class="py-6">
    <h1 class="text-2xl font-semibold tracking-tight">你好，我是 {site.title}</h1>
    <p class="mt-3 leading-relaxed text-stone-600 dark:text-stone-400">{site.intro}</p>
  </section>

  <section class="mt-8">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="text-sm font-medium text-stone-500">近期文章</h2>
      {posts.length > recent.length && <a href="/posts/" class="text-sm text-accent">全部文章 →</a>}
    </div>
    <PostList posts={recent} />
  </section>
</Base>
