---
import PostList from '../components/PostList.astro'
import Base from '../layouts/Base.astro'
import { getPosts } from '../lib/posts'
import { site } from '../site.config'

const posts = await getPosts()
---

<Base>
  <h1>{site.title}</h1>
  <p>{site.intro}</p>
  <h2>Posts</h2>
  <PostList posts={posts} />
</Base>
