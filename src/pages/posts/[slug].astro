---
import { render } from 'astro:content'
import PostMeta from '../../components/PostMeta.astro'
import Toc from '../../components/Toc.astro'
import Base from '../../layouts/Base.astro'
import { getPosts, type Post } from '../../lib/posts'
import { site } from '../../site.config'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

interface Props {
  post: Post
}

const { post } = Astro.props
const { Content, headings } = await render(post)
// 脚注区的标题是给读屏软件的（页面上不显示），不进目录
const toc = headings.filter(
  (heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label',
)
const { title, description } = post.data
---

<Base title={title} description={description} back>
  <article>
    <h1>{title}</h1>
    <PostMeta post={post} detail />
    {description && <p class="text-muted italic">{description}</p>}

    {/* 同一份目录：窄屏是正文开头的列表，宽屏由 global.css 固定到内容栏左侧 */}
    {
      toc.length > 0 && (
        <nav class="toc" aria-label="Table of contents">
          <Toc headings={toc} />
        </nav>
      )
    }

    <Content />
  </article>

  {/* 文章末尾：回复方式一行，返回首页一行。邮件主题预填文章标题 */}
  <footer>
    <p class="flex gap-cw">
      <a href={`mailto:${site.email}?subject=${encodeURIComponent(`Re: ${title}`)}`}>reply via email</a>
      <a href={site.twitter} target="_blank" rel="me noopener">twitter</a>
    </p>
    <p><a href="/">&lt; {site.name}</a></p>
  </footer>

  {/*
    窗口宽度跨过 1300px 时，目录在「悬浮在左侧」和「排在正文开头」之间切换，正文会整体上下移动一个目录的高度。
    这里记住读者眼前的那个段落，切换后把它滚回原来的位置。浏览器自带的滚动锚定管不了这种情况：
    Chrome 里内容栏同时改了外边距，锚定会被取消；Safari 没有滚动锚定。
  */}
  {
    toc.length > 0 && (
      <script is:inline>
        {
          const blocks = [...document.querySelectorAll('article > :not(.toc)')]
          let anchor, top
          const remember = () => {
            anchor = blocks.find((el) => el.getBoundingClientRect().bottom > 0)
            top = anchor?.getBoundingClientRect().top
          }
          addEventListener('scroll', remember, { passive: true })
          matchMedia('(min-width: 1300px)').addEventListener('change', () => {
            if (anchor) scrollBy(0, anchor.getBoundingClientRect().top - top)
            remember()
          })
          remember()
        }
      </script>
    )
  }
</Base>
