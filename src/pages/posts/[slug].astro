---
import { render } from 'astro:content'
import Tags from '../../components/Tags.astro'
import Toc from '../../components/Toc.astro'
import Base from '../../layouts/Base.astro'
import { formatDate, getPosts, type Post } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

interface Props {
  post: Post
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
const { title, description, date, updated, tags } = post.data
---

<Base title={title} description={description} wide>
  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-12">
    <article class="mx-auto w-full max-w-3xl min-w-0">
      <header class="py-6">
        <h1 class="font-serif text-3xl leading-tight font-semibold text-heading">{title}</h1>
        <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
          <time datetime={formatDate(date)} class="tabular-nums">{formatDate(date)}</time>
          {updated && <span>更新于 {formatDate(updated)}</span>}
          {tags.length > 0 && <Tags tags={tags} />}
        </div>
        {description && <p class="mt-4 text-muted">{description}</p>}
      </header>

      {
        toc.length > 0 && (
          <details class="mb-6 rounded-md border border-line px-4 py-3 lg:hidden">
            <summary class="cursor-pointer text-sm text-heading">目录</summary>
            <nav class="mt-3" aria-label="目录">
              <Toc headings={toc} />
            </nav>
          </details>
        )
      }

      <div class="prose max-w-none">
        <Content />
      </div>
    </article>

    {
      toc.length > 0 && (
        <aside class="hidden lg:block">
          <nav class="sticky top-8 max-h-[calc(100vh-4rem)] overflow-y-auto pt-8" aria-label="目录">
            <p class="mb-3 text-sm text-heading">目录</p>
            <Toc headings={toc} />
          </nav>
        </aside>
      )
    }
  </div>
</Base>
