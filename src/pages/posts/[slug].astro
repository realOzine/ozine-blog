---
import { render } from 'astro:content'
import PostMeta from '../../components/PostMeta.astro'
import Toc from '../../components/Toc.astro'
import Base from '../../layouts/Base.astro'
import { getPosts, type Post } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

interface Props {
  post: Post
}

const { post } = Astro.props
const { Content, headings } = await render(post)
// 脚注区的标题是给读屏软件的（页面上不显示），不进目录
const toc = headings.filter(
  (heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label',
)
const { title, description } = post.data
---

<Base title={title} description={description} back>
  <article>
    <h1>{title}</h1>
    <PostMeta post={post} detail />
    {description && <p>{description}</p>}

    {/* 同一份目录：窄屏是正文开头的列表，宽屏由 global.css 固定到内容栏左侧 */}
    {
      toc.length > 0 && (
        <nav class="toc" aria-label="Table of contents">
          <Toc headings={toc} />
        </nav>
      )
    }

    <Content />
  </article>
</Base>
