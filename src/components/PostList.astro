---
import { formatDate, type Post } from '../lib/posts'

interface Props {
  posts: Post[]
}

const { posts } = Astro.props
---

{
  posts.length === 0 ? (
    <p class="text-stone-500">还没有文章。</p>
  ) : (
    <ul class="space-y-6">
      {posts.map((post) => (
        <li>
          <a href={`/posts/${post.id}/`} class="group block">
            <div class="flex flex-col gap-x-4 sm:flex-row sm:items-baseline sm:justify-between">
              <h2 class="font-medium group-hover:text-accent">{post.data.title}</h2>
              <time datetime={formatDate(post.data.date)} class="shrink-0 text-sm tabular-nums text-stone-500">
                {formatDate(post.data.date)}
              </time>
            </div>
            {post.data.description && <p class="mt-1 text-sm text-stone-500">{post.data.description}</p>}
          </a>
        </li>
      ))}
    </ul>
  )
}
