---
import type { Post } from '../lib/posts'
import PostMeta from './PostMeta.astro'

interface Props {
  posts: Post[]
}

const { posts } = Astro.props
---

{
  posts.length === 0 ? (
    <p>No posts yet.</p>
  ) : (
    posts.map((post) => (
      <article>
        <h3>
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
        </h3>
        <PostMeta post={post} />
        {post.data.description && <p>{post.data.description}</p>}
      </article>
    ))
  )
}
