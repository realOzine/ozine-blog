---
import { tagKey } from '../lib/posts'

interface Props {
  tags: { label: string; count?: number }[]
}

const { tags } = Astro.props
---

<ul class="flex flex-wrap gap-2 text-sm">
  {
    tags.map((tag) => (
      <li>
        <a
          href={`/tags/${tagKey(tag.label)}/`}
          class="rounded-full border border-stone-200 px-2.5 py-0.5 text-stone-600 hover:border-accent hover:text-accent dark:border-stone-800 dark:text-stone-400"
        >
          #{tag.label}
          {tag.count !== undefined && <span class="text-stone-400"> {tag.count}</span>}
        </a>
      </li>
    ))
  }
</ul>
